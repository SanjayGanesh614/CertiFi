# Server Configuration
PORT=3001
NODE_ENV=development

# 0G Network Configuration (Using Testnet for Development)
ZG_RPC_URL=https://rpc.0g.ai
ZG_TESTNET_RPC=https://evmrpc-testnet.0g.ai/
ZG_STORAGE_ENDPOINT=https://storage-testnet.0g.ai
ZG_STORAGE_INDEXER=https://indexer-storage-testnet-standard.0g.ai
ZG_COMPUTE_ENDPOINT=https://compute-testnet.0g.ai
ZG_COMPUTE_API_KEY=your_0g_compute_api_key

# Wallet Configuration
PRIVATE_KEY=your_private_key_here
MNEMONIC=your_twelve_word_mnemonic_phrase_here

# Contract Addresses (will be populated after deployment)
VERIRWA_NFT_ADDRESS=
VERIRWA_STAKING_ADDRESS=
VERIRWA_MARKETPLACE_ADDRESS=
VERIRWA_0G_INTEGRATION_ADDRESS=

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h